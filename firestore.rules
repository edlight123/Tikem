rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    function normalizedCountry(raw) {
      return raw is string ? raw.upper() : '';
    }

    function normalizedCurrency(raw) {
      return raw is string ? raw.upper() : '';
    }

    function isCurrencyAllowedForCountry(countryRaw, currencyRaw) {
      let c = normalizedCountry(countryRaw);
      let cur = normalizedCurrency(currencyRaw);

      return (c == 'CA' || c == 'CAN' || c == 'CANADA')
        ? (cur == 'CAD')
        : (c == 'US' || c == 'USA' || c == 'UNITED STATES' || c == 'UNITED_STATES')
          ? (cur == 'USD')
          : (c == 'FR' || c == 'FRA' || c == 'FRANCE')
            ? (cur == 'EUR')
            : (c == 'HT' || c == 'HAITI')
              ? (cur == 'USD' || cur == 'HTG')
              : (cur == 'USD');
    }

    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId));
    }

    function isEventOrganizer(eventId) {
      return isSignedIn() && (
        eventDoc(eventId).data.organizer_id == request.auth.uid ||
        eventDoc(eventId).data.organizerId == request.auth.uid
      );
    }

    function isEventOwner(eventId) {
      return isEventOrganizer(eventId) || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)).data.role == 'owner'
      );
    }

    function isEventMember(eventId) {
      return isSignedIn() && exists(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid));
    }

    function canCheckin(eventId) {
      return isEventOwner(eventId) || (
        isEventMember(eventId) &&
        get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)).data.permissions.checkin == true
      );
    }

    function canViewAttendees(eventId) {
      return isEventOwner(eventId) || (
        isEventMember(eventId) &&
        get(/databases/$(database)/documents/events/$(eventId)/members/$(request.auth.uid)).data.permissions.viewAttendees == true
      );
    }

    function isTicketOwner() {
      return isSignedIn() && (
        (resource.data.user_id == request.auth.uid) ||
        (resource.data.attendee_id == request.auth.uid)
      );
    }

    function ticketEventId() {
      return resource.data.event_id;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Users collection - users can read their own data; writes are restricted to
    // non-privileged profile fields to prevent role/verification escalation.
    match /users/{userId} {
      // H4 (ENFORCED): a user's full doc (email, phone_number, privacy, etc.)
      // is readable only by its owner. Cross-user display reads the SAFE
      // public_profiles/{uid} projection instead; server code uses the Admin
      // SDK (bypasses rules) and is unaffected.
      allow read: if isOwner(userId);

      // Create: users may create their own profile but cannot self-assign privileged roles
      // or mark themselves verified.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'attendee'
        && (request.resource.data.is_verified == false || !(request.resource.data.keys().hasAny(['is_verified'])))
        && (request.resource.data.verification_status == 'none' || !(request.resource.data.keys().hasAny(['verification_status'])));

      // Update: users may update profile fields but cannot change role/verification.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.is_verified == resource.data.is_verified
        && request.resource.data.verification_status == resource.data.verification_status;

      // Delete: disallow client deletes.
      allow delete: if false;
      
      // Notifications subcollection - users can read their own, organizers can send to attendees
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        // M4 (ENFORCED): only the feed owner may create client-side. Cross-user
        // notification fan-out (organizer "Send event update") now goes through
        // the Admin SDK endpoint POST /api/organizer/event-update, which
        // bypasses rules — so client cross-user notification injection is closed.
        allow create: if isOwner(userId);
        allow update, delete: if isOwner(userId);
      }
      
      // FCM Tokens subcollection - users can only access their own tokens
      match /fcmTokens/{tokenId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // Public profiles (H4) - a minimal, read-only projection of a user's SAFE
    // display fields (name, photo, is_verified, bio, username, organization
    // name/logo). Cross-user display reads this instead of users/{uid} so that
    // email/phone_number and other PII stop being client-readable. The owner
    // writes their own projection (sync happens client-side and via Admin SDK on
    // every profile write). No sensitive fields are ever stored here.
    match /public_profiles/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // Legal/help content (terms, privacy, refunds, support) — the single source
    // both web and mobile render. Public read; content is seeded/edited only via
    // the Admin SDK (server), never by clients.
    match /content_pages/{slug} {
      allow read: if true;
      allow write: if false;
    }

    // Connections (friendships) - one document per user pair.
    // Participants may read; all writes go through server APIs (Admin SDK),
    // so client writes are disabled.
    match /connections/{connectionId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.users;
      allow create, update, delete: if false;
    }
    
    // Events collection - public read, authenticated write for organizers
    match /events/{eventId} {
      allow read: if true; // Public events are readable by everyone

      // Currency rules:
      // - CA => CAD only
      // - US => USD only
      // - HT => USD or HTG
      // - otherwise => USD only
      // The creator can only mint events they own — without this, any signed-in
      // account could publish content attributed to another organizer's page.
      //
      // A client also cannot mint an event that is ALREADY published. Publishing
      // has to pass the payout gate (identity, payout profile, and for Stripe
      // markets an account that can actually accept a charge), which only
      // /api/events/[id]/publish can evaluate. Both composers already create a
      // draft and publish as a second, server-side step; this makes that the
      // only possible order rather than a convention a client can skip.
      allow create: if isSignedIn()
        && request.resource.data.organizer_id == request.auth.uid
        && request.resource.data.get('is_published', false) == false
        && isCurrencyAllowedForCountry(request.resource.data.country, request.resource.data.currency);

      allow update: if isSignedIn() && (
        (
          resource.data.organizer_id == request.auth.uid &&
          // H3: moderation fields are client-immutable so a rejected/reported
          // organizer can't re-surface their event. Admin SDK still writes them
          // (it bypasses rules). .get() defaults keep legacy docs that predate
          // these fields writable.
          request.resource.data.get('rejected', false) == resource.data.get('rejected', false) &&
          request.resource.data.get('reports_count', 0) == resource.data.get('reports_count', 0) &&
          // is_published may only travel DOWNWARDS from a client: leave it alone,
          // or turn it off. Turning it ON means money can be taken, and whether
          // that is safe depends on the organizer's payout account — a question
          // no security rule can ask Stripe. So publishing goes through
          // /api/events/[id]/publish, which runs the gate on the Admin SDK and
          // is unaffected by this clause.
          //
          // This was the last hole: the field was deliberately left client-mutable
          // "so organizers can toggle publish", which also let a client publish a
          // paid event whose Stripe account could not accept a charge, and let a
          // stale app build keep doing so after the clients were fixed.
          // Unpublishing stays open — pausing sales is never gated.
          (
            request.resource.data.get('is_published', false) == resource.data.get('is_published', false)
            || request.resource.data.get('is_published', false) == false
          )
        )
        // H2 closed: the tickets_sold clause is gone. That counter is now written
        // only by lib/tickets/inventory.ts via FieldValue.increment on the Admin
        // SDK, inside the same transaction that reserves capacity — so a client
        // has no reason to touch it, and can no longer grief an event to
        // sold-out by inflating it.
      )
      // If country/currency changes, enforce policy.
      && (
        !(request.resource.data.country != resource.data.country || request.resource.data.currency != resource.data.currency)
        || isCurrencyAllowedForCountry(request.resource.data.country, request.resource.data.currency)
      );
      allow delete: if isSignedIn() && resource.data.organizer_id == request.auth.uid;

      // Event members - event-scoped staff/owner roles
      match /members/{memberId} {
        allow read: if isEventOwner(eventId) || (isSignedIn() && request.auth.uid == memberId);
        allow create, update, delete: if false; // Managed server-side via Admin SDK / callable functions
      }

      // Event invites - owner-only visibility, no client writes
      match /invites/{inviteId} {
        allow read: if isEventOwner(eventId);
        allow create, update, delete: if false; // Managed server-side via callable functions
      }
      
      // Event updates subcollection
      match /updates/{updateId} {
        allow read: if true; // Anyone can read event updates
        allow write: if isSignedIn() && (
          exists(/databases/$(database)/documents/events/$(eventId)) &&
          get(/databases/$(database)/documents/events/$(eventId)).data.organizer_id == request.auth.uid
        );
      }

      // Private event data (e.g. password-protected access code hash).
      // Never readable by clients (Admin SDK reads only). The organizer may
      // write the hashed code; the raw code is never stored here.
      match /private/{doc} {
        allow read: if false;
        allow write: if isEventOrganizer(eventId);
      }

      // Access grants - existence proves the user unlocked a password-protected
      // event. Users may read their own grant (to skip the prompt); all writes
      // are server-side (Admin SDK) after a correct code.
      match /access_grants/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false;
      }

      // Access attempts - brute-force throttle bookkeeping. Server-side only.
      match /access_attempts/{uid} {
        allow read, write: if false;
      }
    }
    
    // Event updates collection (separate from events subcollection)
    match /event_updates/{updateId} {
      allow read: if true; // Anyone can read event updates
      // M9: only the event's organizer may write, mirroring the in-event
      // /events/{eventId}/updates subcollection gating.
      allow create: if isSignedIn() &&
        get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.organizer_id == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.organizer_id == request.auth.uid;
    }
    
    // Tickets collection - users can access their own tickets, organizers can access all tickets
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (
        isTicketOwner() ||
        isEventOwner(ticketEventId()) ||
        canViewAttendees(ticketEventId())
      );

      // Clients may no longer create tickets at all. Free claims go through
      // /api/tickets/claim-free (Admin SDK), which enforces what rules cannot:
      // tier ownership, the tier's own price being 0, its is_active and
      // sales-window gates, the per-user limit, and reserveInventoryAtomic.
      //
      // The old rule keyed on `events.ticket_price == 0`. That field is the
      // LOWEST tier price, so once one event could carry a free tier AND a paid
      // tier, it opened on mixed events too — and it never validated tier_id.
      // A signed-in user could self-issue `price_paid: 0` against the 1,500 HTG
      // tier and the scanner would admit them, since it checks event/expiry/
      // duplicate/status but never payment. It also skipped the atomic
      // reservation, so it oversold.
      allow create: if false;

      // Only allow event owners full control; staff may only update check-in related fields.
      allow update: if isSignedIn() && (
        isEventOwner(ticketEventId()) ||
        (
          canCheckin(ticketEventId()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'checked_in',
            'checked_in_at',
            'checked_in_by',
            'entry_point',
            // Whether the door SCANNED a QR or a human picked the attendee off a
            // list. Payout review reads this: a mostly-hand-checked door is a
            // signal, and without the field the signal cannot exist. Staff must be
            // able to write it or every staff check-in would be rejected here.
            'check_in_method',
            'updated_at',
            'reentry_override'
          ])
        )
      );
    }
    
    // Ticket tiers - public read, organizers can manage their event's tiers
    match /ticket_tiers/{tierId} {
      allow read: if true; // Public read for event browsing
      // H1: only the parent event's organizer may create tiers.
      allow create: if isSignedIn() && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.organizer_id == request.auth.uid;
      allow update, delete: if isSignedIn() && get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.organizer_id == request.auth.uid;
    }

    // Group discounts - public read, organizers can manage their event's discounts
    match /group_discounts/{discountId} {
      allow read: if true; // Public read for event browsing
      // H1: only the parent event's organizer may create discounts.
      allow create: if isSignedIn() && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.organizer_id == request.auth.uid;
      allow update, delete: if isSignedIn() && get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.organizer_id == request.auth.uid;
    }
    
    // Promo codes - organizers manage their own event's promo codes. The redemption
    // counter (uses_count) is NEVER client-writable: the "first N buyers" cap is
    // enforced atomically server-side (Admin SDK, redeemPromoInTransaction), so a
    // client must not be able to reset/decrement the counter to bypass the cap.
    // Organizer activation funnel: one doc per organizer, written by the
    // mobile Getting Started checklist with its four computed booleans
    // (create/publish/payouts/team). Owner-only from clients; the admin
    // dashboard reads via the Admin SDK (bypasses rules).
    match /organizer_activation/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /promo_codes/{promoCodeId} {
      // M8: reads stay organizer-only (this is the "clients may read" access for the
      // only client that needs it — the owning organizer). Attendee-side validation
      // and redemption run server-side via the Admin SDK, so attendees never read
      // promo codes directly, and public-readable codes would let anyone harvest
      // active discounts. create validates the INCOMING event_id; read/update/delete
      // validate the STORED doc's event_id.
      allow read: if isSignedIn()
        && get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.organizer_id == request.auth.uid;

      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.organizer_id == request.auth.uid;

      // Organizers may edit discount/expiry/active flags, but uses_count and event_id
      // are immutable from the client (.get defaults keep legacy docs updatable).
      allow update: if isSignedIn()
        && get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.organizer_id == request.auth.uid
        && request.resource.data.get('uses_count', 0) == resource.data.get('uses_count', 0)
        && request.resource.data.event_id == resource.data.event_id;

      allow delete: if isSignedIn()
        && get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.organizer_id == request.auth.uid;
    }

    // Promo code redemptions - append-only ledger of who redeemed which promo,
    // written EXCLUSIVELY by the Admin SDK inside redeemPromoInTransaction. Never
    // client-writable (that would let a buyer fake/skip a redemption) and never
    // client-readable (contains other buyers' user ids / discounts). Server reads
    // via the Admin SDK bypass these rules.
    match /promo_code_usage/{usageId} {
      allow read: if false;
      allow write: if false;
    }

    // Event promoters — same access shape as promo_codes (organizer-managed), with
    // one addition: a promoter who has CLAIMED the record into their own account may
    // read it (their portal reads through the server API, but direct reads are
    // harmless — the doc holds no other buyers' data). All writes that move money
    // facts (the counters) and the claim itself happen via the Admin SDK; from the
    // client the counters, event_id, and claimed_by_uid are immutable.
    match /event_promoters/{promoterId} {
      allow read: if isSignedIn()
        && (
          get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.organizer_id == request.auth.uid
          || resource.data.get('claimed_by_uid', '') == request.auth.uid
        );

      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/events/$(request.resource.data.event_id)).data.organizer_id == request.auth.uid;

      allow update: if isSignedIn()
        && get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.organizer_id == request.auth.uid
        && request.resource.data.event_id == resource.data.event_id
        && request.resource.data.get('tickets_sold', 0) == resource.data.get('tickets_sold', 0)
        && request.resource.data.get('orders_count', 0) == resource.data.get('orders_count', 0)
        && request.resource.data.get('gross_cents', 0) == resource.data.get('gross_cents', 0)
        && request.resource.data.get('commission_cents', 0) == resource.data.get('commission_cents', 0)
        && request.resource.data.get('claimed_by_uid', '') == resource.data.get('claimed_by_uid', '')
        && request.resource.data.get('stats_key', '') == resource.data.get('stats_key', '');

      allow delete: if isSignedIn()
        && get(/databases/$(database)/documents/events/$(resource.data.event_id)).data.organizer_id == request.auth.uid;
    }

    // Promoter sales — append-only commission ledger, written EXCLUSIVELY by the
    // Admin SDK inside the fulfillment claim (recordPromoterSale). Same posture as
    // promo_code_usage: never client-writable, never client-readable (it carries
    // buyer keys and money amounts). Dashboards read it via server APIs.
    match /promoter_sales/{saleId} {
      allow read: if false;
      allow write: if false;
    }
    
    // Favorites - users can only access their own favorites
    match /favorites/{favoriteId} {
      allow read, write: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }
    
    // Event Favorites - users can read their own favorites and create new ones
    match /event_favorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }
    
    // Reviews - authenticated users can create, authors can update/delete
    match /reviews/{reviewId} {
      allow read: if true;
      // M10: bind the review to its author so a signed-in user can't post as
      // someone else.
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }
    
    // Verification requests - organizers can read/write their own
    // Admins need to check server-side, client reads limited to own requests
    match /verification_requests/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // Only allow deletion server-side via Admin SDK
    }
    
    // Organizers collection - organizers can read/write their own data
    match /organizers/{organizerId} {
      allow read: if isSignedIn();
      allow write: if isOwner(organizerId);
      
      // Payout config subcollection
      match /payoutConfig/{configId} {
        allow read: if isOwner(organizerId);
        allow write: if isOwner(organizerId);
      }

      // Payout profiles - READ ONLY from client (writes via server API only)
      // This prevents clients from directly writing sensitive unencrypted data
      match /payoutProfiles/{profileId} {
        allow read: if isOwner(organizerId);
        allow write: if false; // Server-side only via Admin SDK
      }
      
      // Payout destinations - READ ONLY from client (managed via server API)
      // Contains encrypted sensitive data that must only be written server-side
      match /payoutDestinations/{destinationId} {
        allow read: if isOwner(organizerId);
        allow write: if false; // Server-side only via Admin SDK
      }
      
      // Verification documents - READ ONLY from client
      // Document uploads go through server API which validates and stores in Storage
      match /verificationDocuments/{docId} {
        allow read: if isOwner(organizerId);
        allow write: if false; // Server-side only via Admin SDK
      }
    }
    
    // Organizer followers - users can read all, authenticated users can follow/unfollow
    match /organizer_followers/{followId} {
      allow read: if true; // Anyone can see follower counts
      allow create: if isSignedIn() && request.resource.data.follower_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.follower_id == request.auth.uid;
    }
    
    // Organizer follows - users can read all, authenticated users can follow/unfollow
    match /organizer_follows/{followId} {
      allow read: if true; // Anyone can see follower counts
      allow create: if isSignedIn() && request.resource.data.follower_id == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.follower_id == request.auth.uid;
    }
    
    // Admin actions log - read-only for admins (writes via server)
    match /admin_actions/{actionId} {
      allow read: if false; // Admin reads via server SDK only
      allow write: if false; // Only server-side writes
    }
    
    // Ticket transfers collection
    match /ticket_transfers/{transferId} {
      allow read: if isSignedIn() && (
        resource.data.from_user_id == request.auth.uid ||
        resource.data.to_email == request.auth.token.email
      );
      allow create: if isSignedIn() && request.resource.data.from_user_id == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.from_user_id == request.auth.uid ||
        resource.data.to_email == request.auth.token.email
      );
    }
    
    // Attendee -> organizer messages. Created ONLY by the server route, which
    // authenticates the sender, checks they are not the organizer and applies
    // the per-event throttle — none of which a client rule can enforce. The
    // organizer reads their own; the sender reads what they sent.
    //
    // Organizer replies live in a `replies` SUBCOLLECTION of each message. This
    // match does NOT cover subcollections, so replies fall through to the
    // default-deny at the bottom of this file: they are written and read only by
    // the server (/api/organizer/messages/*), which is why the inbox pages fetch
    // over HTTP instead of listening to Firestore. Do not add a client rule for
    // them without also moving the authorization checks out of those routes.
    match /organizer_messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.organizer_id == request.auth.uid ||
        resource.data.sender_id == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
