# Firebase Configuration
# Get from: Firebase Console → Project Settings → General
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Server-side only)
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Copy the entire JSON content as a single line string
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'

# Web Push (VAPID)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Push route protection (optional but recommended)
PUSH_TEST_SECRET=your_random_push_test_secret

# Demo Mode (set to 'true' to enable demo mode with fake data)
NEXT_PUBLIC_DEMO_MODE=false

# Stripe Payment Integration
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Email Notifications (Resend)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Admin Configuration
# Comma-separated list of admin email addresses for verification management
ADMIN_EMAILS=admin@tikem.co,your-email@example.com
ADMIN_EMAIL=admin@tikem.co

# WhatsApp Notifications (Twilio)
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# MonCash Payment Integration (Haiti)
# Get from: https://moncashbutton.digicelgroup.com
MONCASH_CLIENT_ID=your_moncash_client_id
MONCASH_SECRET_KEY=your_moncash_secret_key
MONCASH_MODE=sandbox # or 'production'

# Cron Job Security
# Generate a random secret for securing cron endpoints
CRON_SECRET=your_random_secret_key_here

# App URL (Required for redirects and webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Apple Wallet Pass (Optional — when unset, the app hides "Add to Apple Wallet")
# Get from: https://developer.apple.com
# APPLE_TEAM_ID also activates the iOS Universal Links file at
# /.well-known/apple-app-site-association
APPLE_TEAM_ID=your_apple_team_id
APPLE_PASS_TYPE_ID=pass.co.tikem.ticket
# Passphrase for the private key PEM below. Leave blank if the key is unencrypted.
APPLE_WALLET_KEY_PASSPHRASE=your_certificate_passphrase
#
# Certificate + key, base64 of PEM. Never commit the files themselves.
# 1. Certificates, Identifiers & Profiles > Identifiers > Pass Type IDs:
#    create/select the Pass Type ID (must equal APPLE_PASS_TYPE_ID), create a
#    "Pass Type ID Certificate" for it, download it, and add it to Keychain.
# 2. In Keychain Access export that certificate + its private key as a .p12, then:
#      openssl pkcs12 -legacy -in pass.p12 -clcerts -nokeys -out pass-cert.pem
#      openssl pkcs12 -legacy -in pass.p12 -nocerts -nodes  -out pass-key.pem
#      base64 -i pass-cert.pem | tr -d '\n'   # -> APPLE_PASS_CERT_PEM_BASE64
#      base64 -i pass-key.pem  | tr -d '\n'   # -> APPLE_PASS_KEY_PEM_BASE64
APPLE_PASS_CERT_PEM_BASE64=
APPLE_PASS_KEY_PEM_BASE64=
# 3. Apple WWDR intermediate (G4), from https://www.apple.com/certificateauthority/
#      curl -O https://www.apple.com/certificateauthority/AppleWWDRCAG4.cer
#      openssl x509 -inform der -in AppleWWDRCAG4.cer -out wwdr.pem
#      base64 -i wwdr.pem | tr -d '\n'        # -> APPLE_WWDR_CERT_PEM_BASE64
APPLE_WWDR_CERT_PEM_BASE64=
#
# Optional pass artwork, base64 of PNG. Without these a solid Tikèm-teal square
# is generated so the pass is still openable.
# APPLE_PASS_ICON_PNG_BASE64=   # 29x29
# APPLE_PASS_LOGO_PNG_BASE64=   # ~160x50
#
# Optional. Signs the short-lived .pkpass download links. When unset it is
# derived from APPLE_PASS_KEY_PEM_BASE64, so you only need this to rotate the
# link secret independently of the certificate.
# WALLET_PASS_LINK_SECRET=
# Optional. Name shown on the pass (defaults to "Tikèm").
# WALLET_ORGANIZATION_NAME=Tikèm

# Android App Links (Optional)
# Comma-separated SHA-256 fingerprints of the app signing cert(s).
# Get from `eas credentials` (production keystore) or Play Console > App signing.
# Activates /.well-known/assetlinks.json for co.tikem.mobile
ANDROID_SHA256_CERT_FINGERPRINTS=

# Google Wallet (Optional — when unset, the app hides "Add to Google Wallet")
# Issuer ID: https://pay.google.com/business/console > Google Wallet API
GOOGLE_WALLET_ISSUER_ID=your_google_wallet_issuer_id
# Service account JSON (one line) from Google Cloud Console > IAM & Admin >
# Service Accounts > Keys > Add key (JSON). Grant it the "Wallet Object Issuer"
# role in the Google Pay & Wallet Console. Only client_email + private_key are used.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}'

# Phone sign-in: one-time codes over Meta WhatsApp Cloud API (no Twilio).
# See docs/WHATSAPP_PHONE_AUTH_SETUP.md. Phone auth stays OFF unless
# PHONE_AUTH_ENABLED=true and both WhatsApp vars below are set.
PHONE_AUTH_ENABLED=
AUTH_OTP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional (defaults shown in the doc): template name, Graph version, button, language map
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_OTP_HAS_BUTTON=
WHATSAPP_OTP_TEMPLATE_LANGS=
