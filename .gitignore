# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# firebase functions
/functions/node_modules
/functions/lib
/functions/.firebase
/functions/.runtimeconfig.json

# testing
/coverage

# next.js
/.next/
# Isolated build dirs (NEXT_DIST_DIR=.next-something), used when several
# builds must run at once without corrupting a shared .next. `/.next/`
# alone does not match these, which is how a 77MB `.next-venuemap` tree
# ended up committed.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build-output.log

# FUSE deleted-file artifacts (never real source)
.fuse_hidden*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# expo
.expo/
firebase-debug.log
.env*
.playwright-mcp/

# App Review demo credentials (never commit)
store/app-store/demo.env
