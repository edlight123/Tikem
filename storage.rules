rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Event banner images - allow authenticated users to upload
    // H5: uploads are named `${uid}_${timestamp}.jpg` (see mobile uploadEventImage),
    // so gate write/delete on the filename being prefixed with the uploader's uid.
    // Storage rules can't reach Firestore, so this uid-in-path check is the
    // strongest ownership signal available for this flat path.
    match /event-images/{imageId} {
      allow read: if true; // Public read for event banners
      allow write: if request.auth != null && imageId.matches('^' + request.auth.uid + '_.*')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif|gif)');
      allow delete: if request.auth != null && imageId.matches('^' + request.auth.uid + '_.*');
    }
    
    // KYC uploads (ID front/back, selfie, liveness clip). Read: the owner and
    // the admin allowlist. Admin review signs short-lived URLs server-side
    // (/api/admin/verification-image) and cleanup runs on the Admin SDK
    // (reset-verification, account deletion), which bypass these rules.
    match /verification/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (request.auth.token.email_verified == true && request.auth.token.email in ['info@edlight.org', 'ted.jacquet@edlight.org', 'info.ht.edlight@gmail.com'])
      );
    }

    // CREATE-ONLY, flat files directly under verification/{uid}/. No client
    // overwrite and no client delete: once uploaded, a document an admin may
    // already have reviewed cannot be swapped or removed. Re-uploads use a new
    // timestamped name (web lib/verification.ts, mobile lib/verification.ts).
    //  - photos: jpeg/png/webp/heic/heif only (no SVG, GIF or PDF), < 15MB
    //  - liveness clip (mobile LivenessChallenge, 480p): liveness_* named,
    //    video/mp4 or video/quicktime, < 40MB
    match /verification/{userId}/{fileName} {
      allow create: if request.auth != null && request.auth.uid == userId
        && resource == null
        && (
          (request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)')
            && request.resource.size < 15 * 1024 * 1024)
          ||
          (fileName.matches('liveness_[^/]+')
            && request.resource.contentType.matches('video/(mp4|quicktime)')
            && request.resource.size < 40 * 1024 * 1024)
        );
      allow update, delete: if false;
    }
    
    // User profile images
    match /profile-images/{userId}/{allPaths=**} {
      allow read: if true; // Public read
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif|gif)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Event photos/gallery
    // H5: all uploads/deletes go through the server API (/api/event-photos,
    // Admin SDK, which bypasses these rules) — there is no client-SDK write path.
    // So deny client writes/deletes entirely; public read stays.
    match /event-photos/{eventId}/{allPaths=**} {
      allow read: if true; // Public read
      allow write: if false; // Server-side only via Admin SDK
      allow delete: if false; // Server-side only via Admin SDK
    }
    
    // Payout receipts - admin only
    match /payout-receipts/{organizerId}/{payoutId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == organizerId ||
        (request.auth.token.email_verified == true && request.auth.token.email in ['info@edlight.org', 'ted.jacquet@edlight.org', 'info.ht.edlight@gmail.com'])
      );
      allow write: if request.auth != null && 
        (request.auth.token.email_verified == true && request.auth.token.email in ['info@edlight.org', 'ted.jacquet@edlight.org', 'info.ht.edlight@gmail.com']);
      allow delete: if request.auth != null &&
        (request.auth.token.email_verified == true && request.auth.token.email in ['info@edlight.org', 'ted.jacquet@edlight.org', 'info.ht.edlight@gmail.com']);
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
